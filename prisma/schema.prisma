generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  employee
  viewer
}

model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  name         String
  role         UserRole   @default(viewer)
  passwordHash String     @map("password_hash")
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at")
  audits       AuditLog[]

  @@map("users")
}

model Material {
  id              Int       @id @default(autoincrement())
  nome            String
  precoCompraKg   Decimal   @default(0) @map("preco_compra_kg") @db.Decimal(10, 2)
  precoVendaKg    Decimal   @default(0) @map("preco_venda_kg") @db.Decimal(10, 2)
  estoqueMinimoKg Decimal   @default(0) @map("estoque_minimo_kg") @db.Decimal(10, 3)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  stock           Stock?
  purchases       Purchase[]
  sales           Sale[]

  @@map("materials")
}

model Stock {
  materialId Int      @id @map("material_id")
  quantityKg Decimal  @default(0) @map("quantity_kg") @db.Decimal(12, 3)
  updatedAt  DateTime @updatedAt @map("updated_at")
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@map("stocks")
}

model Purchase {
  id         Int      @id @default(autoincrement())
  materialId Int     @map("material_id")
  weightKg   Decimal @map("weight_kg") @db.Decimal(12, 3)
  pricePerKg Decimal @map("price_per_kg") @db.Decimal(10, 2)
  total      Decimal @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@map("purchases")
}

model Sale {
  id         Int      @id @default(autoincrement())
  materialId Int     @map("material_id")
  weightKg   Decimal @map("weight_kg") @db.Decimal(12, 3)
  pricePerKg Decimal @map("price_per_kg") @db.Decimal(10, 2)
  total      Decimal @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@map("sales")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String
  description String?
  userId      Int?     @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

